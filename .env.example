GOOGLE_API_KEY=your-gemini-api-key-here

# Backend selection — see src/earnings_analyser/config.py's BACKEND_PROFILES.
# "local" (default) uses Ollama with conservative concurrency/batching;
# "cloud" uses Gemini with higher concurrency and larger batches (needs
# GOOGLE_API_KEY above).
EARNINGS_ANALYSER_BACKEND=local

# Optional: override the selected profile's concurrency regardless of
# backend — actual safe concurrency depends on your quota tier / Ollama
# setup, which can't be known in advance.
# EARNINGS_ANALYSER_MAX_WORKERS=16

# Optional: override the cloud profile's requests-per-minute cap. Default
# (12) is tuned for a free-tier Gemini key (measured hard cap: 15/min for
# gemini-flash-lite-latest) — raise this a lot if you're on a paid tier.
# EARNINGS_ANALYSER_REQUESTS_PER_MINUTE=12
